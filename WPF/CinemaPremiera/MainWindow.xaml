<Window x:Class="CinemaPremiera.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaPremiera"
        mc:Ignorable="d"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
            TextElement.Foreground="{DynamicResource MaterialDesignBody}"
            TextElement.FontWeight="Regular"
            TextElement.FontSize="13"
            TextOptions.TextFormattingMode="Ideal"
            TextOptions.TextRenderingMode="Auto"
            FontFamily="{DynamicResource MaterialDesignFont}"
        MinHeight="650" MinWidth="1200" Icon="/images/logo.png"
        Title='Кинотеатр "Премьера"' Height="750" Width="1300" 
        WindowStartupLocation="CenterScreen" Background="#FFF0F0FF"
        WindowState="Maximized" PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#FF3B3273" BorderThickness="0 0 0 1">
                <Border.Effect>
                    <DropShadowEffect Direction="270" BlurRadius="10" ShadowDepth="3" Color="#FF3B3273"/>
                </Border.Effect>
                <Grid Grid.Row="0"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="SlateBlue"/>
                            <GradientStop Color="#FF3B3273" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="images/logo.png" Height="70" Width="110" Margin="0 0 10 0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Grid.Column="2"/>

                    <Button Height="50" Width="50" Click="BtnClick_Menu"
                            BorderThickness="0" Background="Transparent"
                            Grid.Column="0" Margin="10" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Name="Btn_Menu">
                        <Image Source="/images/ThreeLines.png"/>
                    </Button>

                    <TextBlock Text='Кинотеатр "Премьера"' Foreground="White"
                       FontSize="34" FontWeight="DemiBold" Grid.Column="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="0" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <Frame Source="pages/PincodePage.xaml" NavigationUIVisibility="Hidden"
                   Grid.Row="1"/>
        </Grid>

        <Border BorderBrush="DarkSlateBlue"
                BorderThickness="2" 
                CornerRadius="10"
                Background="White"
                Padding="5"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" Name="Border_Menu"
                Margin="10,80,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Vertical" Name="Spanel_Menu"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Height="120" Width="130" Visibility="Visible">
                <Button Height="25" Width="auto"
                        Style="{StaticResource Btn_Filters}">
                    <DockPanel LastChildFill="True">
                        <Image Source="/images/Order.png"
                               Width="20" Height="20"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="Заказы" Margin="5 0 0 0" FontSize="15"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </DockPanel>
                </Button>
                <Button Height="25" Width="auto" Margin="0 5 0 0"
                        Style="{StaticResource Btn_Filters}">
                    <DockPanel LastChildFill="True">
                        <Image Source="/images/Film.png"
                               Width="20" Height="20"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="Фильмы" Margin="5 0 0 0" FontSize="15"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </DockPanel>
                </Button>
                <Button Height="25" Width="auto" Margin="0 5 0 0"
                        Style="{StaticResource Btn_Filters}">
                    <DockPanel LastChildFill="True">
                        <Image Source="/images/Schedule.png"
                               Width="20" Height="20"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="Расписание" Margin="5 0 0 0" FontSize="15"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </DockPanel>
                </Button>
                <Button Height="25" Width="auto" Margin="0 5 0 0"
                        Style="{StaticResource Btn_Filters}"
                        Name="Btn_Exit" Click="BtnClick_Exit">
                    <DockPanel LastChildFill="True">
                        <Image Source="/images/Door_Exit.png"
                               Width="20" Height="20"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выход" Margin="5 0 0 0" FontSize="15"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>
