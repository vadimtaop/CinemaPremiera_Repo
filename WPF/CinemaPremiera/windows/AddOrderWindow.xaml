<Window x:Class="CinemaPremiera.windows.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaPremiera.windows"
        mc:Ignorable="d"
        Title='Кинотеатр "Премьера"' Height="690" Width="450"
        Background="#FFF0F0FF" WindowStartupLocation="CenterScreen"
        Icon="../images/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#FF3B3273" BorderThickness="0 0 0 1">
            <Border.Effect>
                <DropShadowEffect Direction="270" BlurRadius="10" ShadowDepth="3" Color="#FF3B3273"/>
            </Border.Effect>
            <Grid Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="SlateBlue"/>
                        <GradientStop Color="#FF3B3273" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <TextBlock Text="Анкета" FontSize="24" FontWeight="DemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="0" ShadowDepth="2"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Image Source="../images/logo.png" HorizontalAlignment="Right"
                       Height="40" VerticalAlignment="Center" Margin="0 0 5 0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" >
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFCACAFD"/>
                    <GradientStop Color="#FF9696E8" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Vertical" Margin="0 20 10 0" Grid.Column="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Grid.Row="0">
                <TextBlock Text="Номер:*" HorizontalAlignment="Right"
                           FontSize="14" FontWeight="Medium" Name="Tb_Order_ID"
                           Height="25" Visibility="Collapsed"/>
                <TextBlock Text="Дата покупки:*" HorizontalAlignment="Right"
                           FontSize="14" FontWeight="Medium"
                           Height="25" Margin="0 20 0 0"/>
                <TextBlock Text="Название фильма:*" HorizontalAlignment="Right"
                           FontSize="14" FontWeight="Medium" Margin="0 20 0 0"
                           Height="25"/>
                <TextBlock Text="Дата сеанса:*" HorizontalAlignment="Right"
                           FontSize="14" FontWeight="Medium" Margin="0 20 0 0"
                           Height="25"/>
                <TextBlock Text="Цена:*" HorizontalAlignment="Right"
                           FontSize="14" FontWeight="Medium" Margin="0 20 0 0"
                           Height="25"/>
                <TextBlock Text="Количество:*" HorizontalAlignment="Right"
                           FontSize="14" FontWeight="Medium" Margin="0 20 0 0"
                           Height="25"/>
                <TextBlock Text="Сумма в чеке:*" HorizontalAlignment="Right"
                           FontSize="14" FontWeight="Medium" Margin="0 20 0 0"
                           Height="25"/>
                <TextBlock Text="Вид оплаты:*" HorizontalAlignment="Right"
                           FontSize="14" FontWeight="Medium" Margin="0 20 0 0"
                           Height="25"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="10 20 0 0" Grid.Column="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Grid.Row="0">
                <TextBox Height="25" Width="150" Name="Tbox_Order_ID"
                         Style="{StaticResource Tbox_Filters}"
                         IsReadOnly="True" Visibility="Collapsed"/>
                <DatePicker Height="25" Width="150" Margin="0 20 0 0"
                            Name="Dpicker_DateBuy" HorizontalAlignment="Right"
                            Style="{StaticResource Dpicker_Filters}"/>
                <ComboBox Height="25" Width="150" Name="Cbox_Film"
                         Margin="0 20 0 0" IsEditable="True"
                         Style="{StaticResource Cbox_Filters}"/>
                <DatePicker Height="25" Width="150" Margin="0 20 0 0"
                            Name="Dpicker_DateSession" HorizontalAlignment="Right"
                            Style="{StaticResource Dpicker_Filters}"/>
                <ComboBox Height="25" Width="150" Name="Cbox_PriceList"
                         Margin="0 20 0 0" SelectionChanged="Tc_CalcCheckSum"
                         Style="{StaticResource Cbox_Filters}"
                          IsEditable="True"/>
                <TextBox Height="25" Width="150" Name="Tbox_Count"
                         Margin="0 20 0 0" TextChanged="Tc_CalcCheckSum"
                         Style="{StaticResource Tbox_Filters}"/>
                <TextBox Height="25" Width="150" Name="Tbox_CheckSum"
                         Margin="0 20 0 0" IsReadOnly="True"
                         Text="0,00"
                         Style="{StaticResource Tbox_Filters}"/>
                <ComboBox Height="25" Width="150" Name="Cbox_PaymentType"
                         Margin="0 20 0 0" IsEditable="True"
                         Style="{StaticResource Cbox_Filters}"/>
            </StackPanel>

            <StackPanel Grid.ColumnSpan="2" Grid.Row="1" Margin="0 20 0 0"
                        Orientation="Vertical">
                <TextBlock Text="Примечание:" HorizontalAlignment="Center"
                           FontSize="14" FontWeight="Medium" Height="25"/>
                <TextBox Height="100" Width="400" Name="Tbox_Note"
                         Margin="0 10 0 0" TextWrapping="Wrap"
                         Style="{StaticResource Tbox_Filters}"
                         Padding="5"/>

                <Grid Margin="0 40 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Margin="0 0 10 0" Content="Отмена"
                        Height="25" Width="150" FontSize="16"
                        Click="BtnClick_Cancel" Name="Btn_Cancel"
                        Style="{StaticResource Btn_Filters}"
                            Grid.Column="0" HorizontalAlignment="Right"/>

                    <Button Margin="10 0 0 0" Content="Добавить"
                            Height="25" Width="150" FontSize="16"
                            Click="BtnClick_Add" Name="Btn_Add"
                            Style="{StaticResource Btn_Filters}"
                            Grid.Column="1" HorizontalAlignment="Left"/>

                    <Button Margin="10 0 0 0" Content="Сохранить"
                            Height="25" Width="150" FontSize="16"
                            Click="BtnClick_Save" Name="Btn_Save"
                            Style="{StaticResource Btn_Filters}"
                            Grid.Column="1" HorizontalAlignment="Left"
                            Visibility="Collapsed"/>
                </Grid>
            </StackPanel>

        </Grid>

    </Grid>
</Window>
