<Page x:Class="CinemaPremiera.pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CinemaPremiera.pages"
      mc:Ignorable="d"
      d:DesignHeight="875" d:DesignWidth="1300"
      Title="OrderPage">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#FFCACAFD">

            <TabControl TabStripPlacement="Top" BorderBrush="SlateBlue">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="SlateBlue"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}"
                                            BorderBrush="DarkGray" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter Name="Content" ContentSource="Header"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!--Активная вкладка-->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="White"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="SlateBlue"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="1 1 0.5 0"/>
                                            <Setter TargetName="Border" Property="CornerRadius" Value="0 0 0 0"/>
                                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="Black"/>
                                        </Trigger>
                                        <!--Неактивная вкладка-->
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="#CACAFD"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="SlateBlue"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="0.5 1 1 0"/>
                                            <Setter TargetName="Border" Property="CornerRadius" Value="0 0 0 0"/>
                                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="Black"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>
                </TabControl.Resources>
                <TabControl.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFCACAFD"/>
                        <GradientStop Color="#FF9696E8" Offset="1"/>
                    </LinearGradientBrush>
                </TabControl.Background>

                <TabItem Header="Фильтры" Width="98">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition MinHeight="30" Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,10,0,0" Grid.Row="0">
                                <TextBlock Text="Фильтр" HorizontalAlignment="Center"
                                       FontSize="22" FontWeight="DemiBold"/>
                                <TextBlock Text="Общий поиск" Margin="0 10 0 0"
                                       Style="{StaticResource Tblock_Filters}"/>
                                <TextBox x:Name="Tbox_Search" Margin="0 10 0 0"
                                     Height="25" Width="150" FontSize="16"
                                     Style="{StaticResource Tbox_Filters}"/>
                                <TextBlock Text="Номер заказа" Margin="0 10 0 0"
                                       Style="{StaticResource Tblock_Filters}"/>
                                <TextBox x:Name="Tbox_Order_ID" Margin="0 10 0 0"
                                     Height="25" Width="150" FontSize="16"
                                     Style="{StaticResource Tbox_Filters}"/>
                                <TextBlock Text="Дата покупки (с):" Margin="0 10 0 0"
                                       Style="{StaticResource Tblock_Filters}"/>
                                <DatePicker Height="25" Width="150" Margin="0 10 0 0"
                                        Name="Dpicker_DateBuyS" SelectedDateChanged="DateBuyS_SelectedDateChanged"
                                        Style="{StaticResource Dpicker_Filters}"/>
                                <TextBlock Text="Дата покупки (по):" Margin="0 10 0 0"
                                       Style="{StaticResource Tblock_Filters}"/>
                                <DatePicker Height="25" Width="150" Margin="0 10 0 0" 
                                        Name="Dpicker_DateBuyPo" IsEnabled="False"
                                        SelectedDateChanged="DateBuyPo_SelectedDateChanged"
                                        Style="{StaticResource Dpicker_Filters}"/>
                                <TextBlock Text="Название фильма:" Margin="0 10 0 0" 
                                       Style="{StaticResource Tblock_Filters}"/>
                                <ComboBox Height="25" Width="150" Margin="0 10 0 0" Name="Cbox_Film"
                                     Style="{StaticResource Cbox_Filters}" IsEditable="True"/>
                                <TextBlock Text="Дата сеанса" Margin="0 10 0 0"
                                       Style="{StaticResource Tblock_Filters}"/>
                                <DatePicker Height="25" Width="150" Margin="0 10 0 0" Name="Dpicker_DateSession"
                                        Style="{StaticResource Dpicker_Filters}"/>
                                <TextBlock Text="Цена:" Margin="0 10 0 0" 
                                       Style="{StaticResource Tblock_Filters}"/>
                                <ComboBox Height="25" Width="150" Margin="0 10 0 0"
                                          Name="Cbox_PriceList" IsEditable="True"
                                          Style="{StaticResource Cbox_Filters}"/>
                                <TextBlock Text="Количество:" Margin="0 10 0 0" 
                                       Style="{StaticResource Tblock_Filters}"/>
                                <TextBox Height="25" Width="150" Margin="0 10 0 0" Name="Tbox_Count"
                                     Style="{StaticResource Tbox_Filters}"/>
                                <TextBlock Text="Сумма в чеке:" Margin="0 10 0 0" 
                                       Style="{StaticResource Tblock_Filters}"/>
                                <TextBox Height="25" Width="150" Margin="0 10 0 0" Name="Tbox_CheckSum"
                                     Style="{StaticResource Tbox_Filters}"/>
                                <TextBlock Text="Вид оплаты:" Margin="0 10 0 0" 
                                       Style="{StaticResource Tblock_Filters}"/>
                                <ComboBox Height="25" Width="150" Margin="0 10 0 0"
                                      Name="Cbox_PaymentType" IsEditable="True"
                                          Style="{StaticResource Cbox_Filters}"/>
                                <TextBlock Text="Примечание:" Margin="0 10 0 0" 
                                       Style="{StaticResource Tblock_Filters}"/>
                                <TextBox Height="25" Width="150" Margin="0 10 0 0" Name="Tbox_Note"
                                     Style="{StaticResource Tbox_Filters}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0 0 0 10" HorizontalAlignment="Center">
                                <Button Margin="0 0 0 0" Content="Применить"
                                    Height="25" Width="150" FontSize="16"
                                    Click="BtnClick_Apply" Name="Btn_Apply"
                                    IsDefault="True" Style="{StaticResource Btn_Filters}"/>
                                <Button Margin="0 10 0 0" Content="Сбросить"
                                    Height="25" Width="150" FontSize="16"
                                    Click="BtnClick_ResetFilters" Name="Btn_ResetFilters"
                                    Style="{StaticResource Btn_Filters}"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

                </TabItem>
                <TabItem Header="Управление" Width="98">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0 0 0 0">
                            <TextBlock Text="Управление" HorizontalAlignment="Center"
                                   FontSize="22" FontWeight="DemiBold" Margin="0 10 0 0"/>
                            <Button Margin="0 10 0 0" Content="Добавить"
                                    Height="25" Width="150" FontSize="16"
                                    Click="BtnClick_Add" Name="Btn_Add"
                                    Style="{StaticResource Btn_Filters}"/>
                            <Button Margin="0 10 0 0" Content="Удалить"
                                    Height="25" Width="150" FontSize="16"
                                    Click="BtnClick_Delete" Name="Btn_Delete"
                                    Style="{StaticResource Btn_Filters}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Экспорт / Импорт" HorizontalAlignment="Center"
                                   FontSize="22" FontWeight="DemiBold" Margin="0 20 0 0"/>
                            <Button Height="50" Width="150" FontSize="16" Margin="0 10 0 0"
                                Click="BtnClick_ExportExcel_Full" Name="Btn_ExportExcel_Full"
                                Style="{StaticResource Btn_Filters}">
                                <TextBlock TextWrapping="Wrap" Text="Общий экспорт (.xlsx)" 
                                       TextAlignment="Center"/>
                            </Button>
                            <Button Height="50" Width="150" FontSize="16" Margin="0 10 0 0"
                                Click="BtnClick_ExportExcel_Filter" Name="Btn_ExportExcel_Filter"
                                Style="{StaticResource Btn_Filters}">
                                <TextBlock TextWrapping="Wrap" Text="Фильтрованный экспорт (.xlsx)" 
                                       TextAlignment="Center"/>
                            </Button>

                            <Button Height="50" Width="150" FontSize="16" Margin="0 10 0 0"
                                Click="BtnClick_ImportExcel" Name="Btn_ImportExcel"
                                Style="{StaticResource Btn_Filters}">
                                <TextBlock TextWrapping="Wrap" Text="Импорт данных (.xlsx)" 
                                       TextAlignment="Center"/>
                            </Button>
                        </StackPanel>

                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <DataGrid Grid.Column="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" Name="DG_Orders" HorizontalScrollBarVisibility="Auto"
                  AlternationCount="2" AlternatingRowBackground="#f2f0fb" 
                  RowBackground="White">
            <DataGrid.Resources>
                <!--Текст по центру-->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="DarkSlateBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Regular"/>
                </Style>
                <!--Изменение фона заголовков-->
            </DataGrid.Resources>
            <DataGrid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFCACAFD"/>
                    <GradientStop Color="#FF9696E8" Offset="1"/>
                </LinearGradientBrush>
            </DataGrid.Background>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" MinWidth="50" Binding="{Binding Order_ID}"/>
                <DataGridTextColumn Header="Дата покупки" MinWidth="85" Binding="{Binding DateBuy, StringFormat=\{0:dd.MM.yyyy\}}"/>
                <DataGridTextColumn Header="Название фильма" MinWidth="120" Width="120*" Binding="{Binding Film.Title}"/>
                <DataGridTextColumn Header="Дата сеанса" MinWidth="85" Binding="{Binding DateSession, StringFormat=\{0:dd.MM.yyyy\}}"/>
                <DataGridTextColumn Header="Цена" MinWidth="50" Binding="{Binding PriceList.Price}"/>
                <DataGridTextColumn Header="Кол-во" MinWidth="50" Binding="{Binding Count}"/>
                <DataGridTextColumn Header="Сумма в чеке" MinWidth="90" Binding="{Binding CheckSum}"/>
                <DataGridTextColumn Header="Вид оплаты" MinWidth="130" Binding="{Binding PaymentType.Title}"/>
                <DataGridTextColumn Header="Примечание" MinWidth="100" Width="100*" Binding="{Binding Note}"/>
                <DataGridTemplateColumn MinWidth="75" MaxWidth="75" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Width="75">
                                <Button VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Width="20" Height="20"
                                        Name="Btn_Edit" Click="BtnClick_Edit"
                                        Background="#FFCACAFD" Margin="2.5 0 2.5 0">
                                    <Image Source="../images/Pencil.png" Height="15" Width="15"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <Button VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Width="20" Height="20"
                                        Name="Btn_TrashDelete" Click="BtnClick_TrashDelete"
                                        Background="#f02622" Margin="2.5 0 2.5 0">
                                    <Image Source="../images/Trash.png" Height="15" Width="15"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Name="DeleteCheckBox" Width="20" Height="20"
                                          Margin="2.5 0 2.5 0"/>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
