<Page x:Class="CinemaPremiera.pages.FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CinemaPremiera.pages"
      mc:Ignorable="d" 
      d:DesignHeight="875" d:DesignWidth="1300"
      Title="FilmPage">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#FFCACAFD">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition MinHeight="30" Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,10,0,0" Grid.Row="0">
                        <TextBlock Text="Фильтр" HorizontalAlignment="Center"
                                   FontSize="22" FontWeight="DemiBold"/>
                        <TextBlock Text="Общий поиск" Margin="0 10 0 0"
                                   Style="{StaticResource Tblock_Filters}"/>
                        <TextBox Name="Tbox_Search" Margin="0 10 0 0"
                                 Height="25" Width="150" FontSize="16"
                                 Style="{StaticResource Tbox_Filters}"/>
                        <TextBlock Text="Номер" Margin="0 10 0 0"
                                   Style="{StaticResource Tblock_Filters}"/>
                        <TextBox Name="Tbox_FilmID" Margin="0 10 0 0"
                                 Height="25" Width="150" FontSize="16"
                                 Style="{StaticResource Tbox_Filters}"/>
                        <TextBlock Text="Название фильма:" Margin="0 10 0 0" 
                                   Style="{StaticResource Tblock_Filters}"/>
                        <TextBox Height="25" Width="150" Margin="0 10 0 0" Name="Tbox_Title"
                                 Style="{StaticResource Tbox_Filters}"/>
                        <TextBlock Text="Возрастное ограничение" Margin="0 10 0 0"
                                   Style="{StaticResource Tblock_Filters}"/>
                        <TextBox Height="25" Width="150" Margin="0 10 0 0" Name="Tbox_AgeLimit"
                                 Style="{StaticResource Tbox_Filters}"/>
                        <TextBlock Text="Длительность в минутах" Margin="0 10 0 0" 
                                   Style="{StaticResource Tblock_Filters}"/>
                        <TextBox Height="25" Width="150" Margin="0 10 0 0" Name="Tbox_DurationInMinutes"
                                 Style="{StaticResource Tbox_Filters}"/>
                        <TextBlock Text="Жанр:" Margin="0 10 0 0"
                                   Style="{StaticResource Tblock_Filters}"/>
                        <TextBox Height="25" Width="150" Margin="0 10 0 0" Name="Tbox_Genre"
                                 Style="{StaticResource Tbox_Filters}"/>
                        
                        <TextBlock Text="Управление" HorizontalAlignment="Center"
                                       FontSize="22" FontWeight="DemiBold" Margin="0 40 0 0"/>
                        <Button Margin="0 10 0 0" Content="Добавить"
                                    Height="25" Width="150" FontSize="16"
                                    Click="BtnClick_Add" Name="Btn_Add"
                                    Style="{StaticResource Btn_Filters}"/>
                        <Button Margin="0 10 0 0" Content="Удалить"
                                    Height="25" Width="150" FontSize="16"
                                    Click="BtnClick_Delete" Name="Btn_Delete"
                                    Style="{StaticResource Btn_Filters}"/>

                        <TextBlock Text="Экспорт / Импорт" HorizontalAlignment="Center"
                                   FontSize="22" FontWeight="DemiBold" Margin="0 40 0 0"/>
                        <Button Height="50" Width="150" FontSize="16" Margin="0 10 0 0"
                                Click="BtnClick_ExportExcel_Full" Name="Btn_ExportExcel_Full"
                                Style="{StaticResource Btn_Filters}">
                        <TextBlock TextWrapping="Wrap" Text="Общий экспорт (.xlsx)" 
                                   TextAlignment="Center"/>
                        </Button>
                        <Button Height="50" Width="150" FontSize="16" Margin="0 10 0 0"
                                Click="BtnClick_ExportExcel_Filter" Name="Btn_ExportExcel_Filter"
                                Style="{StaticResource Btn_Filters}">
                        <TextBlock TextWrapping="Wrap" Text="Фильтрованный экспорт (.xlsx)" 
                                   TextAlignment="Center"/>
                        </Button>
                        <Button Height="50" Width="150" FontSize="16" Margin="0 10 0 0"
                                Click="BtnClick_ImportExcel" Name="Btn_ImportExcel"
                                Style="{StaticResource Btn_Filters}">
                        <TextBlock TextWrapping="Wrap" Text="Импорт данных (.xlsx)" 
                                   TextAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0 0 0 10" HorizontalAlignment="Center">
                        <Button Margin="0 0 0 0" Content="Применить"
                                    Height="25" Width="150" FontSize="16"
                                    Click="BtnClick_Apply" Name="Btn_Apply"
                                    IsDefault="True" Style="{StaticResource Btn_Filters}"/>
                        <Button Margin="0 10 0 0" Content="Сбросить"
                                    Height="25" Width="150" FontSize="16"
                                    Click="BtnClick_ResetFilters" Name="Btn_ResetFilters"
                                    Style="{StaticResource Btn_Filters}"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

        </Grid>

        <DataGrid Grid.Column="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" Name="DG_Films" HorizontalScrollBarVisibility="Auto"
                  AlternationCount="2" AlternatingRowBackground="#f2f0fb" 
                  RowBackground="White">
            <DataGrid.Resources>
                <!--Текст по центру-->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="DarkSlateBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Regular"/>
                </Style>
                <!--Изменение фона заголовков-->
            </DataGrid.Resources>
            <DataGrid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFCACAFD"/>
                    <GradientStop Color="#FF9696E8" Offset="1"/>
                </LinearGradientBrush>
            </DataGrid.Background>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" MinWidth="50" Binding="{Binding Film_ID}"/>
                <DataGridTextColumn Header="Название фильма" MinWidth="120" Width="120*" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Возрастное ограничение" MinWidth="150" Binding="{Binding AgeLimit}"/>
                <DataGridTextColumn Header="Длительность в минутах" MinWidth="140" Binding="{Binding DurationInMinutes}"/>
                <DataGridTextColumn Header="Жанр" MinWidth="75" Width="75*" Binding="{Binding Genre}"/>
                <DataGridTemplateColumn MinWidth="75" MaxWidth="75" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Width="75">
                                <Button VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Width="20" Height="20"
                                        Name="Btn_Edit" Click="BtnClick_Edit"
                                        Background="#FFCACAFD" Margin="2.5 0 2.5 0">
                                    <Image Source="../images/Pencil.png" Height="15" Width="15"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <Button VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Width="20" Height="20"
                                        Name="Btn_TrashDelete" Click="BtnClick_TrashDelete"
                                        Background="#f02622" Margin="2.5 0 2.5 0">
                                    <Image Source="../images/Trash.png" Height="15" Width="15"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Name="DeleteCheckBox" Width="20" Height="20"
                                          Margin="2.5 0 2.5 0"/>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
