<Application x:Class="CinemaPremiera.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CinemaPremiera"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DatePicker.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Btn_Pincode" TargetType="Button">
                <Setter Property="Height" Value="75"/>
                <Setter Property="Width" Value="75"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="DarkSlateBlue"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontSize" Value="44"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="100"/>
                    </Style>
                </Style.Resources>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            </Style>

            <!--Элементы фильтров-->

            <Style x:Key="Tblock_Filters" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="Tbox_Filters" TargetType="TextBox">
                <Setter Property="BorderBrush" Value="SlateBlue"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="Dpicker_Filters" TargetType="DatePicker">
                <Setter Property="BorderBrush" Value="SlateBlue"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="Cbox_Filters" TargetType="ComboBox">
                <Setter Property="BorderBrush" Value="SlateBlue"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="Btn_Filters" TargetType="Button">
                <Setter Property="BorderBrush" Value="SlateBlue"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
            </Style>




        </ResourceDictionary>




        

    </Application.Resources>
</Application>
